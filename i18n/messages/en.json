  "faq": {
    "eyebrow": "FAQ",
    "title": "Frequently asked questions",
    "lede": "Can't find the answer? Write to us and we'll reply the same working day.",
    "items": [
      {
        "q": "How far in advance should I book the equipment?",
        "a": "We recommend 2–3 weeks ahead for large events, but we also handle urgent requests, depending on what is available in stock."
      },
      {
        "q": "Do you provide a technician at the event?",
        "a": "Yes. Every rental includes a technician who installs, tests and monitors the equipment for the whole duration of the event."
      },
      {
        "q": "Do you deliver outside Chișinău?",
        "a": "Yes, we deliver and install across the country. Transport costs are calculated based on distance and the volume of equipment."
      },
      {
        "q": "How many languages can be interpreted simultaneously?",
        "a": "Our systems support up to 16 channels — that is up to 16 languages interpreted in parallel, plus the original floor channel."
      },
      {
        "q": "Do you offer ISO 4043 compliant booths?",
        "a": "Yes. We use sound-insulated mobile booths compliant with the ISO 4043 standard, with quiet ventilation and dedicated lighting for interpreters."
      },
      {
        "q": "How do I get a price quote?",
        "a": "Fill in the configurator or call us directly. We come back with a recommended configuration and a price, usually the same working day."
      }
    ]
