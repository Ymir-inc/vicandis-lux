# /etc/vicandis-lux/quote.env on the API box (root:root, mode 600).
# Key names only. Real values live on the server, never in this public repo.
# PORT is NOT read from here: vicandis-lux-quote.service pins PORT=8180.
RESEND_API_KEY=
# Comma-separated for several recipients.
QUOTE_TO=
# e.g. "VicandisLux <quote@vicandislux.md>" (domain verified in Resend, EU).
QUOTE_FROM=
