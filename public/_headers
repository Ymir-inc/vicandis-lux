# Security & caching headers.
#
# Read by Cloudflare Pages and Netlify. GitHub Pages ignores this file, so the
# throwaway preview is unaffected. Production is nginx, which ignores it too —
# the rules below have to be mirrored by hand in the server config (see
# TAKEOVER.md §3); this file is the canonical statement of what they should be.
# CSP allows 'unsafe-inline' for scripts and styles because this
# is a static export (no per-request nonce) that inlines Next's bootstrap and
# the design's style attributes — see tasks/OWNER-TODO.md for tightening it.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; manifest-src 'self'; form-action 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed, immutable build assets.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Brand artwork. None of it is fingerprinted — Next emits `/icon.svg`,
# `/apple-icon.png` and `/og.png` at bare, stable URLs, and browsers ask for
# `/favicon.ico` by that path whatever the markup says. A long TTL therefore
# keeps serving the *previous* logo for its whole duration after a rebrand, so
# these get a day and a revalidation rather than a week of silence.
/og.png
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate

/icon.svg
  Cache-Control: public, max-age=86400, must-revalidate

/apple-icon.png
  Cache-Control: public, max-age=86400, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate

/icons/*
  Cache-Control: public, max-age=86400, must-revalidate

/brand/*
  Cache-Control: public, max-age=86400, must-revalidate
